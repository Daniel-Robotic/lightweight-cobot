      appearance PBRAppearance {
        baseColor 0.64 0.68 0.72
        roughness 0.45
        metalness 0.45
      }
      geometry Mesh {
        url [ "../../objects/grant/base-detail.obj" ]
      }
    }
  ]
  boundingObject Pose {
    translation 0 0.000695 0
    children [ Box { size 0.30 0.00915 0.17 } ]
  }
}
DEF BODY_HATCH_CAP Solid {
  translation 0.30 0.12 0.82594
  rotation 0.862856209461 0.357406744337 0.357406744337 1.717771517458
  name "body_hatch_cap"
  locked TRUE
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.78 0.82 0.86
        roughness 0.35
        metalness 0.55
      }
