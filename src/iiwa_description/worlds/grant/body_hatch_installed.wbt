        url [ "../../objects/grant/cap.obj" ]
      }
    }
  ]
  boundingObject Pose {
    translation 0 0.004165 0
    children [ Box { size 0.1384 0.00367 0.0984 } ]
  }
}

# The rack is visible in the front-left work area, facing the robot.
GrantToolRack {
  translation 0.12 -0.42 0.793
  rotation 0 0.70710678118 0.70710678118 3.14159265359
}
